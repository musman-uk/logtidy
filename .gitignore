/target/

# Local Cargo config (machine-specific target-dir)
.cargo/

# Cargo package files
**/*.rs.bk

# VS Code settings (optional, but keeps repo clean)
.vscode/

# Logs or temporary files (keep test fixtures tracked)
*.log
!tests/fixtures/*.log

# Generated code bundles
*-code.txt

# OS-specific noise
.DS_Store
Thumbs.db
